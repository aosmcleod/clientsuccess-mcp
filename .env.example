# Required
CS_USERNAME=your-email@example.com
CS_PASSWORD=your-password

# Optional: Log level (debug, info, warn, error)
CS_LOG_LEVEL=info

# Optional: Segment filtering
# If your ClientSuccess account manages multiple products/segments, configure
# the custom field and values used to distinguish them.
# CS_SEGMENT_FIELD=system__cs
# CS_SEGMENT_VALUES={"ProductA": "", "ProductB": "productb"}

# Optional: Renewal date field
# Custom field key that stores the client renewal/contract end date.
# Required for the renewals list tool to work.
# CS_RENEWAL_DATE_FIELD=Next_Renewal_Date__cs
